# Copy to .env and fill in. Commands read it with `node --env-file-if-exists=.env`.

# ── Store and source (process) ──────────────────────────────────────────────
# SQLite file for the outbox and the source's tables. Default ./unyt-harvester-example.db.
STORE_PATH=
# tokens (default) or nomad.
SOURCE=
# The token source's JSON-lines usage log. Default ./token-usage.jsonl.
TOKEN_LOG_PATH=
# Measurement window in ms. Default 86400000 (one day).
WINDOW_MS=

# ── Invoicing (invoice, fund, unlock) ───────────────────────────────────────
# Your agreement, as printed by `npm run provision`. Required.
AGREEMENT_ID=
# Your lane's definition hash ("u"-prefixed base64; `npm run ops lanes` prints
# it). Required. Any version works: each run cites the version in force.
LANE_DEFINITION_IDS=
# Invoice period in ms, a multiple of WINDOW_MS. Default 86400000.
INVOICE_PERIOD_MS=
# Billing policy JSON (see policy.example.json). Unset: inputTokens→TOKIN,
# outputTokens→TOKOUT.
POLICY_PATH=

# ── Funding ─────────────────────────────────────────────────────────────────
# Park FUND_TOP_UP_HF onto the agreement when its available HF is below
# FUND_MIN_HF. Both or neither.
FUND_MIN_HF=
FUND_TOP_UP_HF=
# Log an alert when the harvester's HF balance is below this.
BALANCE_ALERT_HF=

# ── Holochain conductor ─────────────────────────────────────────────────────
# Admin port (hc:init, provision) and app port of the conductor running the
# harvester's unyt app.
HC_ADMIN_PORT=
HC_APP_PORT=
# Installed app id of the harvester's unyt app. Default unyt.
HC_APP_ID=
# Signing creds written by `npm run hc:init`. Default ./harvester-hc-creds.json.
HC_CREDS_PATH=

# ── Nomad source (SOURCE=nomad) ─────────────────────────────────────────────
NOMAD_ADDR=
# ACL token sent as X-Nomad-Token; blank when ACLs are off.
NOMAD_TOKEN=
NOMAD_REGION=
# 1 to skip TLS verification (self-signed certs).
NOMAD_SKIP_VERIFY=
# watch: ms between allocation re-pulls, idle reconnect, agent-key refresh.
FLUSH_INTERVAL_MS=
IDLE_TIMEOUT_MS=
AGENT_REFRESH_MS=
