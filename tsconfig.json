{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "types": ["node"],
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src"]
}
